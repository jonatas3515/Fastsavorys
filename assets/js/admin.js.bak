        'recebido': 'recebido',
        'aceito': 'aceito',
        'em_preparo': 'em_preparo',
        'pronto': 'pronto',
        'saiu_entrega': 'saiu_entrega',
        'entregue': 'entregue',
        'cancelado': 'cancelado'
    },

    // Mapeamento reverso: português -> ingléªs (para enviar ao banco)
    statusToDb: {
        'recebido': 'pending',
        'aceito': 'accepted',
        'em_preparo': 'preparing',
        'pronto': 'confirmed',
        'saiu_entrega': 'out_for_delivery',
        'entregue': 'delivered',
        'cancelado': 'cancelled'
    },

    defaults: {
        recebido: 'Olá {{nome}}! Recebemos seu pedido #{{pedido}} com sucesso. 🎂\nResumo: {{itens}}\nTotal: R$ {{total}}\nJá vamos começar a preparar!',
        recebido_pix: 'Olá {{nome}}! Recebemos seu pedido #{{pedido}} com sucesso. 🎂\nResumo: {{itens}}\nTotal: R$ {{total}}\nPagamento: 🔄 PIX\n\nPara confirmar seu pedido, efetue o pagamento de no mínimo 50% do valor do pedido.\nSegue chave Pix (e-mail):\n\n{{pix_key}}\n\nApós o pagamento, envie o comprovante.',
        aceito: '{{saudacao}}, {{nome}}! 🎂\n\nSeu pedido #{{pedido}} foi *ACEITO* pela Fast Savory\'s!\n\nPara confirmar sua encomenda, realize o pagamento pelo link:\n{{payment_link}}\n\n🔄 *Opções:*\n• Mínimo 50% agora (entrada)\n• Ou valor total\n\n*Valor:* R$ {{total}}\n\nObrigado! â¤ï¸',
        em_preparo: 'Olá {{nome}}! Seu pedido #{{pedido}} já está sendo preparado com muito carinho! 👨‍🍳\nTempo estimado: {{preparo}} min.',
        pronto: 'Opa {{nome}}! Seu pedido #{{pedido}} está PRONTO! ✅\n{{tipo_entrega}}',
