        entregue: 'Olá, {{nome}}! 😊\n\nSeu pedido *{{pedido}}* foi entregue!\n\nNos ajude a melhorar: avalie sua experiência:\n{{rating_link}}\n\nObrigado por escolher a Fast Savory\'s! 🍽️â¤ï¸',
        cancelado: 'Olá {{nome}}. Infelizmente seu pedido #{{pedido}} foi cancelado.\nMotivo: {{motivo}} 💳',

        // Templates para ENCOMENDAS (pedidos agendados)
        recebido_encomenda_entrega: 'Olá {{nome}}! Recebemos sua encomenda #{{pedido}} com sucesso. 🎂\nResumo: {{itens}}\nTotal: R$ {{total}}\n\n🔄& *Entrega agendada para {{data_encomenda}} é s {{hora_encomenda}}.*\\nSeu pedido será preparado com muito carinho e entregue no horário combinado.\\n\\nAguarde nossa confirmação! 🔄:',
        recebido_encomenda_retirada: 'Olá {{nome}}! Sua encomenda #{{pedido}} está confirmada. ✅\nResumo: {{itens}}\nTotal: R$ {{total}}\n\n🔄& *Estará pronta para retirada em {{data_encomenda}} é s {{hora_encomenda}}.*\\nCapricharemos em cada detalhe para você receber tudo fresquinho! 🍽️',
        recebido_encomenda_pix: 'Olá {{nome}}! Recebemos sua encomenda #{{pedido}}. 👁️‍🗨️\nResumo: {{itens}}\nTotal: R$ {{total}}\nPagamento: 🔄 PIX\n\n🔄& *Agendado para {{data_encomenda}} é s {{hora_encomenda}}.*\\n\\nPara confirmar, efetue o pagamento de no mínimo 50% do valor.\\nSegue chave Pix (e-mail):\\n\n{{pix_key}}\n\nApós o pagamento, envie o comprovante.'
    },

    getAll: function () {
        const saved = localStorage.getItem('fastMsgTemplates');
        return saved ? { ...this.defaults, ...JSON.parse(saved) } : this.defaults;
    },

    save: function (templates) {
        localStorage.setItem('fastMsgTemplates', JSON.stringify(templates));
    },

    // Extrai primeiro nome ou nome composto (ex: "João Pedro" de "João Pedro dos Santos Costa")
    getFirstName: function (fullName) {
        if (!fullName) return 'Cliente';
        const parts = fullName.trim().split(/\s+/);
        if (parts.length <= 2) return fullName.trim();
        // Conectores comuns em português
        const connectors = ['de', 'da', 'do', 'das', 'dos', 'e'];
        // Pega primeiro nome e segundo se não for conector
        let firstName = parts[0];
        if (parts.length > 1 && !connectors.includes(parts[1].toLowerCase())) {
            firstName += ' ' + parts[1];
        }
        return firstName;
    },

    // Gera saudação diné¢mica baseada no horário
    getGreeting: function () {
        const hour = new Date().getHours();
        if (hour >= 5 && hour < 12) return 'Bom dia';
        if (hour >= 12 && hour < 18) return 'Boa tarde';
        return 'Boa noite';
    },

    getFormatted: function (status, order) {
        // Mapeia o status para a chave correta do template
        // Se status vazio, usa 'recebido' como padrão
        const safeStatus = status || 'recebido';
        let templateKey = this.statusMap[safeStatus] || safeStatus;

        // Detectar se é ENCOMENDA (pedido agendado para o futuro)
        const encomendaDate = order.scheduled_date || order.encomenda_date || order.encomendaDate;
        const encomendaSlot = order.scheduled_time || order.encomenda_slot || order.encomendaSlot;
        const isEncomenda = !!(encomendaDate && encomendaDate.trim());

        // Check if PIX payment
        const isPixPayment = order.payment_method === 'pix';
        const isRecebidoStatus = (templateKey === 'recebido');

        // Escolher template correto para status "recebido"
        if (isRecebidoStatus) {
            if (isEncomenda) {
                // 🔢 uma encomenda - escolher template baseado no tipo de entrega e pagamento
                if (isPixPayment && window.storeConfig?.pix_key) {
                    templateKey = 'recebido_encomenda_pix';
                } else if (order.delivery_type === 'entrega') {
                    templateKey = 'recebido_encomenda_entrega';
                } else {
                    templateKey = 'recebido_encomenda_retirada';
                }
            } else if (isPixPayment && window.storeConfig?.pix_key) {
                // Pedido imediato com PIX
                templateKey = 'recebido_pix';
            }
        }

        const tpl = this.getAll()[templateKey] || this.defaults.recebido;

        if (!tpl) {
            console.warn('[MsgTemplate] Template não encontrado para status:', status, '-> key:', templateKey);
        }

        const itemsSummary = (order.items || []).map(i => `${i.quantity}x ${i.name}`).join(', ');
        const address = order.address ? `${order.address.street}, ${order.address.number}` : 'Balcão';
        const deliveryText = order.delivery_type === 'entrega' ? 'Aguarde o entregador.' : 'Pode vir retirar!';
        const prepTime = `${window.storeConfig?.prep_time_min || 20}-${window.storeConfig?.prep_time_max || 40}`;

        // Usa apenas primeiro nome (ou nome composto)
        const firstName = this.getFirstName(order.client_name);

        // Saudação diné¢mica
        const greeting = this.getGreeting();

        // Gerar link de avaliação
        // Assume formatOrderCode and buildRatingLink are global
        const orderCode = order.order_code || (window.formatOrderCode ? window.formatOrderCode(order.id) : `FAST-${order.id}`);
        // Check if buildRatingLink is available
        const ratingLink = window.buildRatingLink ? window.buildRatingLink(orderCode, order.client_phone) : '#';

        // Formatar data e hora da encomenda
        let dataEncomenda = encomendaDate || '';
        let horaEncomenda = encomendaSlot || '';

        // Formatar data se estiver no formato YYYY-MM-DD
        if (dataEncomenda && dataEncomenda.includes('-')) {
            const parts = dataEncomenda.split('-');
            if (parts.length === 3) {
                dataEncomenda = `${parts[2]}/${parts[1]}/${parts[0]}`; // DD/MM/YYYY
            }
        }

        return tpl
            .replace(/{{nome}}/g, firstName)
            .replace(/{{pedido}}/g, orderCode)
            .replace(/{{total}}/g, (order.total || 0).toFixed(2).replace('.', ','))
            .replace(/{{itens}}/g, itemsSummary || 'Itens do pedido')
            .replace(/{{endereco}}/g, address)
            .replace(/{{motivo}}/g, 'Imprevisto na cozinha')
            .replace(/{{tipo_entrega}}/g, deliveryText)
            .replace(/{{preparo}}/g, prepTime)
            .replace(/{{saudacao}}/g, greeting)
            .replace(/{{payment_link}}/g, order.payment_link || '[Link será enviado]')
            .replace(/{{rating_link}}/g, ratingLink)
            .replace(/{{pix_key}}/g, window.storeConfig?.pix_key || '[Chave PIX não configurada]')
            .replace(/{{data_encomenda}}/g, dataEncomenda || '[Data não informada]')
            .replace(/{{hora_encomenda}}/g, horaEncomenda || '[Horário não informado]');
    }
};

// Global Order Update Functions (moved from fast.html)
let pendingStatusUpdate = null;
let pendingMsgUpdateData = null;

function checkFutureDeliveryDate(scheduledDate) {
    if (!scheduledDate) return { isFuture: false, formattedDate: null };
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const scheduled = new Date(scheduledDate + 'T00:00:00');
    scheduled.setHours(0, 0, 0, 0);
    const isFuture = scheduled > today;
    const parts = scheduledDate.split('-');
    const formattedDate = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : scheduledDate;
    return { isFuture, formattedDate };
}

function showFutureDateWarning(orderId, scheduledDate, newStatus) {
    hideFutureDateWarning();
    const { formattedDate } = checkFutureDeliveryDate(scheduledDate);
    const warningId = `futureDateWarning_${orderId}`;
    const warningHtml = `
    <div id="${warningId}" class="fixed inset-0 bg-black/60 z-[100] flex items-center justify-center p-4" onclick="if(event.target===this) hideFutureDateWarning();">
      <div class="bg-white rounded-xl shadow-2xl p-6 max-w-md w-full mx-4 border-l-4 border-orange-500" onclick="event.stopPropagation();">
        <div class="flex items-start gap-3 mb-4">
          <span class="text-3xl">⚠️</span>
          <div>
            <h4 class="font-bold text-gray-800 text-lg">Pedido com Data Futura</h4>
            <p class="text-gray-600 mt-2">Este pedido <strong>não é para ser entregue hoje</strong>. A data é <strong class="text-orange-600">${formattedDate}</strong>.</p>
            <p class="text-gray-600 mt-2">Deseja mudar o status?</p>
          </div>
        </div>
        <div class="flex gap-3 justify-end">
          <button onclick="hideFutureDateWarning()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg">Cancelar</button>
          <button onclick="confirmStatusUpdate(${orderId}, '${newStatus}')" class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg">Mudar Mesmo Assim</button>
        </div>
      </div>
    </div>`;
    document.body.insertAdjacentHTML('beforeend', warningHtml);
    pendingStatusUpdate = { orderId, newStatus };
}

function hideFutureDateWarning() {
    document.querySelectorAll('[id^="futureDateWarning_"]').forEach(el => el.remove());
    pendingStatusUpdate = null;
    pendingMsgUpdateData = null;
}

function showFutureDateWarningWithMessage(orderId, scheduledDate, newStatus, msg, phone) {
    hideFutureDateWarning();
    const { formattedDate } = checkFutureDeliveryDate(scheduledDate);
    pendingMsgUpdateData = { orderId, dbStatus: newStatus, msg, phone };
    const warningId = `futureDateWarning_${orderId}`;
    const warningHtml = `
    <div id="${warningId}" class="fixed inset-0 bg-black/60 z-[100] flex items-center justify-center p-4" onclick="if(event.target===this) hideFutureDateWarning();">
      <div class="bg-white rounded-xl shadow-2xl p-6 max-w-md w-full mx-4 border-l-4 border-orange-500" onclick="event.stopPropagation();">
        <div class="flex items-start gap-3 mb-4">
          <span class="text-3xl">⚠️</span>
          <div>
            <h4 class="font-bold text-gray-800 text-lg">Pedido com Data Futura</h4>
            <p class="text-gray-600 mt-2">Este pedido <strong>não é para hoje</strong> (${formattedDate}).</p>
            <p class="text-gray-600 mt-2">Deseja mudar o status e enviar a mensagem?</p>
          </div>
        </div>
        <div class="flex gap-3 justify-end">
          <button onclick="hideFutureDateWarning()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg">Cancelar</button>
          <button onclick="confirmStatusUpdateWithMessage()" class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg">Confirmar</button>
        </div>
      </div>
    </div>`;
    document.body.insertAdjacentHTML('beforeend', warningHtml);
}

window.confirmStatusUpdateWithMessage = async function () {
    if (!pendingMsgUpdateData) { hideFutureDateWarning(); return; }
    const { orderId, dbStatus, msg, phone } = pendingMsgUpdateData;
    hideFutureDateWarning();
    if (phone) {
        const cleanPhone = phone.replace(/\D/g, '');
        window.open(`https://wa.me/55${cleanPhone}?text=${encodeURIComponent(msg)}`, '_blank');
    }
    await executeStatusUpdate(orderId, dbStatus);
}

window.confirmStatusUpdate = async function (orderId, newStatus) {
    hideFutureDateWarning();
    await executeStatusUpdate(orderId, newStatus);
}

// Log Order Change
async function logOrderChange(orderId, orderCode, oldStatus, newStatus, notes = '') {
    try {
        const currentUser = sessionStorage.getItem('fastAdmin') || 'Sistema';
        const logEntry = { order_id: orderId, order_code: orderCode, old_status: oldStatus, new_status: newStatus, changed_by: currentUser, changed_at: new Date().toISOString(), notes: notes };
        await window.supabaseClient.from('fast_order_logs').insert(logEntry).catch(e => console.warn('Supabase log error', e));
    } catch (e) { console.error('[OrderLog]', e); }
}

window.executeStatusUpdate = async function (orderId, newStatus, orderData = null) {
    try {
        let order = orderData;
        if (!order) {
            const { data } = await window.supabaseClient.from('fast_orders').select('*').eq('id', orderId).single();
            order = data;
        }
        const oldStatus = order?.status || 'unknown';
        if (newStatus === 'delivered' && order && (order.payment_method?.startsWith('cartao') || order.payment_method === 'card_stripe')) {
            if (order.payment_status !== 'paid_full') {
                showToast('⚠️ Pagamento em cartão não está completo!', 'warning');
                return;
            }
        }
        const { error } = await window.supabaseClient.from('fast_orders').update({ status: newStatus }).eq('id', orderId);
        if (error) throw error;

        const orderCode = order?.order_code || formatOrderCode(order?.order_sequence || order?.id);
        await logOrderChange(orderId, orderCode, oldStatus, newStatus);

        loadDashboardOrders();
    } catch (error) {
        console.error('Erro ao atualizar status:', error);
        showToast('Erro ao atualizar status.', 'error');
    }
}

// Prepare Update Modal
window.prepareOrderUpdate = async function (orderId) {
    const { data: order } = await window.supabaseClient.from('fast_orders').select('*').eq('id', orderId).single();
    if (!order) return;

    // Check if modal exists in DOM (it should be in fast.html but we might need to inject it if we want full separation)
    // For now assuming modal HTML exists in fast.html
    const modal = document.getElementById('msgUpdateModal');
    if (!modal) return;

    document.getElementById('msgUpdateOrderId').value = orderId;
    document.getElementById('msgUpdateStatus').value = order.status;
    const reasonSelect = document.getElementById('cancellationReason');
    if (reasonSelect) reasonSelect.value = '';

    const updatePreview = () => {
        const newStatus = document.getElementById('msgUpdateStatus').value;
        const reasonSection = document.getElementById('cancellationReasonSection');
        if (newStatus === 'cancelado') reasonSection.classList.remove('hidden');
        else reasonSection.classList.add('hidden');

        if (window.MsgTemplateService) {
            let tpl = '';
            if (newStatus === 'cancelado') {
                const reasonKey = document.getElementById('cancellationReason').value;
                // Need CANCELLATION_TEMPLATES. Assuming global or we redefine.
                // Ideally CANCELLATION_TEMPLATES should be globally available.
                if (reasonKey && window.CANCELLATION_TEMPLATES && window.CANCELLATION_TEMPLATES[reasonKey]) {
                    tpl = window.CANCELLATION_TEMPLATES[reasonKey];
                    const firstName = window.MsgTemplateService.getFirstName(order.client_name);
                    const orderCode = order.order_code || formatOrderCode(order.id);
                    tpl = tpl.replace(/{{nome}}/g, firstName).replace(/{{pedido}}/g, orderCode);
                    document.getElementById('msgUpdatePreview').value = tpl;
                    return;
                }
            }
            document.getElementById('msgUpdatePreview').value = window.MsgTemplateService.getFormatted(newStatus, order);
        }
    };

    document.getElementById('msgUpdateStatus').onchange = updatePreview;
    document.getElementById('cancellationReason').onchange = updatePreview;
    updatePreview();
    modal.classList.remove('hidden');

    // Bind verify/confirm button from modal
    const confirmBtn = document.getElementById('confirmMsgUpdate');
    const cancelBtn = document.getElementById('cancelMsgUpdate');

    // Bind Cancel Button (Robustness Fix)
    if (cancelBtn) {
        // Ensure it closes
        const newCancel = cancelBtn.cloneNode(true);
        cancelBtn.parentNode.replaceChild(newCancel, cancelBtn);
        newCancel.addEventListener('click', () => modal.classList.add('hidden'));
    }

    if (confirmBtn) {
        const newBtn = confirmBtn.cloneNode(true);
        confirmBtn.parentNode.replaceChild(newBtn, confirmBtn);
        newBtn.addEventListener('click', async () => {
            const newStatus = document.getElementById('msgUpdateStatus').value;
            const msg = document.getElementById('msgUpdatePreview').value;
            // Convert status if needed (MsgTemplateService.statusToDb)
            const dbStatus = (window.MsgTemplateService?.statusToDb && window.MsgTemplateService.statusToDb[newStatus]) || newStatus;

            // Check future date
            const statusesQueNaoDevemSerAlterados = ['preparing', 'confirmed', 'out_for_delivery', 'delivered'];
            if (order.scheduled_date && statusesQueNaoDevemSerAlterados.includes(dbStatus)) {
                const { isFuture } = checkFutureDeliveryDate(order.scheduled_date);
                if (isFuture) {
                    showFutureDateWarningWithMessage(orderId, order.scheduled_date, dbStatus, msg, order.client_phone);
                    modal.classList.add('hidden');
                    return;
                }
            }

            // Send WhatsApp
            if (order.client_phone) {
                const cleanPhone = order.client_phone.replace(/\D/g, '');
                window.open(`https://wa.me/55${cleanPhone}?text=${encodeURIComponent(msg)}`, '_blank');
            }
            await executeStatusUpdate(orderId, dbStatus, order);
            modal.classList.add('hidden');
        });
    }
}

