window.renderFastFeesList = typeof renderFastFeesList !== 'undefined' ? renderFastFeesList : function () { console.error('renderFastFeesList missing'); };

window.closeFeesFastModal = function () {
    document.getElementById('feesModalFast').classList.add('hidden');
};

window.switchPromoTab = function (tabName) {
    if (document.getElementById('promoTabCoupons')) document.getElementById('promoTabCoupons').classList.add('hidden');
    if (document.getElementById('promoTabAutomatic')) document.getElementById('promoTabAutomatic').classList.add('hidden');
    if (document.getElementById('promoTabLoyalty')) document.getElementById('promoTabLoyalty').classList.add('hidden');
    if (document.getElementById('promoTabProducts')) document.getElementById('promoTabProducts').classList.add('hidden');

    if (tabName === 'coupons') {
        document.getElementById('promoTabCoupons').classList.remove('hidden');
        if (typeof renderCoupons === 'function') renderCoupons();
    } else if (tabName === 'automatic') {
        document.getElementById('promoTabAutomatic').classList.remove('hidden');
        // Load automatic config if needed
    } else if (tabName === 'loyalty') {
        document.getElementById('promoTabLoyalty').classList.remove('hidden');
        // Load loyalty config if needed
    } else if (tabName === 'products') {
        document.getElementById('promoTabProducts').classList.remove('hidden');
        loadProductsForPromotions();
    }

    // Update active tab style
    const buttons = document.querySelectorAll('#promotionsPanelFast button[id^="promoTabBtn"]');
    buttons.forEach(btn => {
        if (btn.getAttribute('onclick')?.includes(`'${tabName}'`)) {
            btn.classList.add('border-b-2', 'border-rose-600', 'text-rose-600');
            btn.classList.remove('text-gray-500');
        } else {
            btn.classList.remove('border-b-2', 'border-rose-600', 'text-rose-600');
            btn.classList.add('text-gray-500');
        }
    });
};

