/**
 * ADMIN MODULE - Fast Savory's
 * Contains all administrative logic, dashboards, and management tools.
 */

// ========================================
// INITIALIZATION & EVENT BINDING
// ========================================
document.addEventListener('DOMContentLoaded', async () => {
    // Check for #bypass hash (coming from store with session preserved)
    // Check for #bypass hash (coming from store with session preserved)
    if (window.location.hash === '#bypass') {
        const hasSession = sessionStorage.getItem('fastAdmin') === '1';
        if (hasSession) {
            // Clear the hash to keep URL clean
            history.replaceState(null, '', 'admin.html');
            // Show admin panel directly
            showAdminPanel();
        }
    } else {
        // Check local session persistence logic
        const savedSession = sessionStorage.getItem('fastAdmin');
        if (savedSession === '1') {
            currentUserRole = sessionStorage.getItem('fastRole') || 'admin';
            showAdminPanel();
        }
    }

    // Bind Admin Event Listeners if elements exist
    loadUsers(); // Load users from local storage

    // Fetch products from Supabase for admin panel
    if (typeof fetchProductsFromSupabase === 'function') {
        await fetchProductsFromSupabase();
    }

    bindAdminEvents();
});

function bindAdminEvents() {
    // Login / Logout
    document.getElementById('loginForm')?.addEventListener('submit', handleLoginSubmit);
    const adminLoginBtn = document.getElementById('adminLoginBtn');
    if (adminLoginBtn) { adminLoginBtn.addEventListener('click', showLoginModal); }
    document.getElementById('logoutBtn')?.addEventListener('click', handleLogout);
    document.getElementById('logoutBtnMobile')?.addEventListener('click', handleLogout);

    // Navigation
    document.getElementById('backToAdminBtn')?.addEventListener('click', showAdminPanel);

    // Admin Panel Navigation Buttons
    const navMap = {
        'showProductsPanelFast': 'productsPanelFast',
        'showClientsPanelFast': 'clientsPanelFast',
        'showPromotionsPanelFast': 'promotionsPanelFast',
        'showConfigPanelFast': 'configPanelFast',
        'showReportsPanelFast': 'reportsPanelFast',
        'showOrdersPanelFast': 'ordersPanelFast',
        'showRatingsPanelFast': 'ratingsPanelFast',
        'showBannerPanelFast': 'bannerPanelFast',
        'showRulesPanelFast': 'rulesPanelFast',

        // Mobile
        'showProductsPanelFastMobile': 'productsPanelFast',
        'showClientsPanelFastMobile': 'clientsPanelFast',
        'showPromotionsPanelFastMobile': 'promotionsPanelFast',
        'showConfigPanelFastMobile': 'configPanelFast',
        'showReportsPanelFastMobile': 'reportsPanelFast',
        'showOrdersPanelFastMobile': 'ordersPanelFast',
        'showRatingsPanelFastMobile': 'ratingsPanelFast',
        'showBannerPanelFastMobile': 'bannerPanelFast',
        'showRulesPanelFastMobile': 'rulesPanelFast'
    };

    Object.entries(navMap).forEach(([btnId, panelId]) => {
        document.getElementById(btnId)?.addEventListener('click', async () => {
            showPanel(panelId);
            // Load specific data based on panel
            if (panelId === 'productsPanelFast') {
                loadProductsAdmin();
                // Load product options for the personalization section
                if (typeof ProductOptionsModule !== 'undefined' && !ProductOptionsModule.loaded) {
                    await ProductOptionsModule.load();
                }
                renderOptionsListAdmin();
            }
            if (panelId === 'clientsPanelFast') {
                if (window.ClientDiscountsService) {
                    if (typeof window.ClientDiscountsService.init === 'function' && !window.ClientDiscountsService.loaded) {
                        await window.ClientDiscountsService.init();
                    } else if (typeof window.ClientDiscountsService.load === 'function') {
                        await window.ClientDiscountsService.load();
                    }
                }
                renderClients();
                updateClientDiscountSelect();
            }
            if (panelId === 'promotionsPanelFast') {
                renderPromotions();
                updatePromotionProductSelect();
                updateClientDiscountSelect();
                renderCoupons();
                loadSpecialDiscountConfig(); // Helper needed
                loadBirthdayDiscountConfig(); // Helper needed
            }
            if (panelId === 'reportsPanelFast') { await loadOrders(); renderReportsData(); }
            if (panelId === 'ordersPanelFast') loadDashboardOrders();
            if (panelId === 'configPanelFast') { renderUsers(); renderFastFeesListPanel(); if (typeof loadCouriers === 'function') loadCouriers(); }
            if (panelId === 'ratingsPanelFast') { if (window.RatingsModule) RatingsModule.initAdminPanel(); }
            if (panelId === 'rulesPanelFast') { loadRulesPanel(); }
            if (panelId === 'bannerPanelFast') { if (window.BannerModule) { await BannerModule.loadConfig(); BannerModule.loadAdminForm(); } }
        });
    });

    // Product Form
    document.getElementById('productForm')?.addEventListener('submit', handleProductSubmit);

    // Filters
    document.addEventListener('click', (e) => {
        if (e.target.classList.contains('admin-filter')) {
            adminFilter = e.target.getAttribute('data-filter');
            loadProductsAdmin();
        }
    });

    // Order Dashboard Filters
    document.getElementById('ordersFilterDate')?.addEventListener('change', loadDashboardOrders);
    document.getElementById('ordersFilterStatus')?.addEventListener('change', loadDashboardOrders);
    document.getElementById('refreshOrdersBtn')?.addEventListener('click', loadDashboardOrders);

    // Delete Orders
    document.getElementById('confirmDeleteOrdersBtn')?.addEventListener('click', deleteOrdersByCodes);
    document.getElementById('confirmDeleteOrdersModalBtn')?.addEventListener('click', executeDeleteOrders);
    document.getElementById('cancelDeleteOrdersModalBtn')?.addEventListener('click', () => {
        document.getElementById('deleteOrdersModal').classList.add('hidden');
    });

    // Fees Panel
    document.getElementById('addFeeFastPanel')?.addEventListener('click', handleAddFeePanel);
    document.getElementById('saveAllFeesFastPanel')?.addEventListener('click', handleSaveAllFeesPanel);
    document.getElementById('feesListFastPanel')?.addEventListener('click', handleFeeListClick);
    document.getElementById('feesListFastPanel')?.addEventListener('change', handleFeeListChange);
    document.getElementById('batchUpdateMin')?.addEventListener('click', handleBatchUpdateMin);

    // Store Config
    document.getElementById('saveCardFees')?.addEventListener('click', handleSaveCardFees);
    document.getElementById('saveBusinessHours')?.addEventListener('click', handleSaveBusinessHours);
    document.getElementById('saveDeliverySettings')?.addEventListener('click', handleSaveDeliverySettings);

    // Misc
    document.getElementById('savePixConfig')?.addEventListener('click', handleSavePixConfig);
    document.getElementById('userForm')?.addEventListener('submit', handleUserSubmit);
    document.getElementById('addCouponBtn')?.addEventListener('click', handleSaveCoupon);
    document.getElementById('saveSpecialDiscountConfig')?.addEventListener('click', handleSaveSpecialDiscountConfig);
    document.getElementById('saveBirthdayDiscountConfig')?.addEventListener('click', handleSaveBirthdayDiscountConfig);
    document.getElementById('saveBannerBtn')?.addEventListener('click', async () => {
        if (window.BannerModule && typeof window.BannerModule.save === 'function') {
            await window.BannerModule.save();
        }
    });

    // Auto-Archive Check
    setTimeout(checkAutoArchive, 10000);

    // Product Options (Massas, Recheios, etc.)
    // Product Options (Massas, Recheios, etc.)
    initProductOptionsUI();

    // Orders View Mode
    document.getElementById('viewModeKanban')?.addEventListener('click', () => switchOrdersView('kanban'));
    document.getElementById('viewModeList')?.addEventListener('click', () => switchOrdersView('list'));

    // Product Search & Filter
    document.getElementById('adminSearchInput')?.addEventListener('input', (e) => {
        loadProductsAdmin();
    });

    // Fix: Listen to Dropdown Change
    document.getElementById('adminCategoryFilter')?.addEventListener('change', (e) => {
        console.log('[DEBUG] adminCategoryFilter CHANGE! Valor:', e.target.value);
        window.adminFilter = e.target.value;
        console.log('[DEBUG] window.adminFilter atualizado para:', window.adminFilter);
        loadProductsAdmin();
    });

    document.getElementById('adminProductStatusFilter')?.addEventListener('change', (e) => {
        console.log('[DEBUG] adminProductStatusFilter CHANGE! Valor:', e.target.value);
        window.adminFilter = e.target.value;
        console.log('[DEBUG] window.adminFilter atualizado para:', window.adminFilter);
        loadProductsAdmin();
    });

    // Clients Search
    document.getElementById('clientSearchInput')?.addEventListener('input', () => {
        if (window.clientSearchTimeout) clearTimeout(window.clientSearchTimeout);
        window.clientSearchTimeout = setTimeout(() => { if (typeof renderClients === 'function') renderClients(); }, 300);
    });

    document.getElementById('clientInitialFilter')?.addEventListener('change', () => {
        if (typeof renderClients === 'function') renderClients();
    });

    // Restore view mode preference
    const savedViewMode = localStorage.getItem('fastOrdersViewMode') || 'kanban';
    switchOrdersView(savedViewMode);
}

function switchOrdersView(mode) {
    const kanbanBtn = document.getElementById('viewModeKanban');
    const listBtn = document.getElementById('viewModeList');
    const kanbanView = document.getElementById('ordersKanbanView');
    const listView = document.getElementById('ordersListView');

    if (!kanbanBtn || !listBtn || !kanbanView || !listView) return;

    if (mode === 'kanban') {
        kanbanBtn.className = 'px-3 py-1.5 rounded-md text-sm font-medium bg-white text-gray-800 shadow-sm transition-all';
        listBtn.className = 'px-3 py-1.5 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 transition-all';
        kanbanView.classList.remove('hidden');
        listView.classList.add('hidden');
    } else {
        listBtn.className = 'px-3 py-1.5 rounded-md text-sm font-medium bg-white text-gray-800 shadow-sm transition-all';
        kanbanBtn.className = 'px-3 py-1.5 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 transition-all';
        listView.classList.remove('hidden');
        kanbanView.classList.add('hidden');
    }
    localStorage.setItem('fastOrdersViewMode', mode);
}

// ========================================
// PRODUCT OPTIONS UI (Admin Panel)
// ========================================
let currentOptionsType = 'cakeMass';

function initProductOptionsUI() {
    // Options Tabs
    document.querySelectorAll('.options-tab').forEach(tab => {
        tab.addEventListener('click', (e) => {
            document.querySelectorAll('.options-tab').forEach(t => {
                t.classList.remove('bg-rose-600', 'text-white');
                t.classList.add('bg-gray-200', 'text-gray-700');
            });
            e.target.classList.remove('bg-gray-200', 'text-gray-700');
            e.target.classList.add('bg-rose-600', 'text-white');
            currentOptionsType = e.target.dataset.type;
            renderOptionsListAdmin();
        });
    });

    // Add New Option Button
    document.getElementById('addNewOptionBtn')?.addEventListener('click', async () => {
        const input = document.getElementById('newOptionName');
        const name = input?.value?.trim();
        if (!name) return showOptionsMessage('Digite o nome da opção', 'error');

        const result = await ProductOptionsModule.add(currentOptionsType, name);
        if (result.success) {
            input.value = '';
            showOptionsMessage('Opção adicionada com sucesso!', 'success');
            renderOptionsListAdmin();
        } else {
            showOptionsMessage(result.error || 'Erro ao adicionar', 'error');
        }
    });

    // Options List Click Delegation
    document.getElementById('optionsListContainer')?.addEventListener('click', async (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        const id = parseInt(btn.dataset.id);
        if (!id) return;

        if (btn.classList.contains('edit-option-btn')) {
            const newName = await showPrompt('Novo nome:', btn.dataset.name, { title: 'Editar Opção' });
            if (newName && newName.trim()) {
                await ProductOptionsModule.update(id, { name: newName.trim() });
                showToast('Opção atualizada!', 'success');
                renderOptionsListAdmin();
            }
        } else if (btn.classList.contains('toggle-option-btn')) {
            await ProductOptionsModule.toggleVisibility(id);
            renderOptionsListAdmin();
        } else if (btn.classList.contains('delete-option-btn')) {
            const confirmed = await showConfirm('Excluir esta opção?', {
                title: 'Excluir Opção',
                icon: '🔄ï¸',
                danger: true
            });
            if (confirmed) {
                await ProductOptionsModule.delete(id);
                showToast('Opção excluída!', 'success');
                renderOptionsListAdmin();
            }
        }
    });

    // Initial load
    if (ProductOptionsModule.loaded) {
        renderOptionsListAdmin();
    }
}

function showOptionsMessage(text, type) {
    const el = document.getElementById('optionsMessage');
    if (!el) return;
    el.textContent = text;
    el.className = `mb-4 p-3 rounded-lg text-sm ${type === 'error' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 3000);
}

function renderOptionsListAdmin() {
    const container = document.getElementById('optionsListContainer');
    if (!container) return;

    const items = ProductOptionsModule.getAll(currentOptionsType) || [];
    if (items.length === 0) {
        container.innerHTML = '<p class="text-gray-500 text-sm">Nenhuma opção cadastrada.</p>';
        return;
    }

    container.innerHTML = items.map(opt => `
        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border ${opt.visible ? '' : 'opacity-60'}">
            <span class="text-sm font-medium text-gray-800">${opt.name}</span>
            <div class="flex items-center gap-2">
                <button class="edit-option-btn px-2 py-1 text-xs bg-yellow-100 hover:bg-yellow-200 text-yellow-800 rounded" data-id="${opt.id}" data-name="${opt.name}"> Editar</button>
                <button class="toggle-option-btn px-2 py-1 text-xs ${opt.visible ? 'bg-orange-100 text-orange-800' : 'bg-green-100 text-green-800'} rounded" data-id="${opt.id}">${opt.visible ? ' Ocultar' : ' Mostrar'}</button>
                <button class="delete-option-btn px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-800 rounded" data-id="${opt.id}"></button>
            </div>
        </div>
    `).join('');
}

// ========================================
// NAVIGATION & AUTH
// ========================================

function hideAllAdminPanels() {
    ['adminPanel', 'productsPanelFast', 'configPanelFast', 'clientsPanelFast',
        'promotionsPanelFast', 'reportsPanelFast', 'ordersPanelFast', 'ratingsPanelFast', 'bannerPanelFast', 'rulesPanelFast'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.add('hidden');
        });
}

async function showPanel(panelName) {
    const panels = ['productsPanelFast', 'clientsPanelFast', 'promotionsPanelFast', 'configPanelFast', 'reportsPanelFast', 'ordersPanelFast', 'ratingsPanelFast', 'bannerPanelFast', 'rulesPanelFast'];
    panels.forEach(p => {
        const el = document.getElementById(p);
        if (el) el.classList.toggle('hidden', p !== panelName);
    });

    // Load panel-specific data
    switch (panelName) {
        case 'productsPanelFast':
            loadProductsAdmin();
            // Load product options for the personalization section
            if (typeof ProductOptionsModule !== 'undefined') {
                if (!ProductOptionsModule.loaded) {
                    await ProductOptionsModule.load();
                }
                renderOptionsListAdmin();
            }
            break;
        case 'ordersPanelFast':
            loadDashboardOrders();
            break;
        case 'clientsPanelFast':
            renderClients();
            updateClientDiscountSelect();
            break;
        case 'promotionsPanelFast':
            renderPromotions();
            updatePromotionProductSelect();
            updateClientDiscountSelect();
            renderCoupons();
            if (typeof loadSpecialDiscountConfig === 'function') loadSpecialDiscountConfig();
            if (typeof loadBirthdayDiscountConfig === 'function') loadBirthdayDiscountConfig();
            break;
        case 'reportsPanelFast':
            await loadOrders();
            renderReportsData();
            break;
        case 'configPanelFast':
            renderUsers();
            renderFastFeesListPanel();
            if (typeof loadCouriers === 'function') loadCouriers();
            break;
        case 'ratingsPanelFast':
            if (window.RatingsModule) RatingsModule.initAdminPanel();
            break;
        case 'rulesPanelFast':
            if (typeof loadRulesPanel === 'function') loadRulesPanel();
            break;
        case 'bannerPanelFast':
            if (window.BannerModule) {
                await BannerModule.loadConfig();
                BannerModule.loadAdminForm();
            }
            break;
    }
}

function showLoginModal() {
    hideAllAdminPanels();
    document.getElementById('loginModal').classList.remove('hidden');
    document.getElementById('publicStore')?.classList.add('hidden'); // Check existence

    // Hide admin wrapper if exists
    const adminWrapper = document.getElementById('adminWrapper');
    if (adminWrapper) adminWrapper.classList.add('hidden');

    document.getElementById('cartBtn')?.classList.add('hidden');
    document.getElementById('cartBtnDesktop')?.classList.add('hidden');
    const floatingBtn = document.getElementById('floatingCartButton');
    if (floatingBtn) {
        floatingBtn.classList.add('hidden');
        floatingBtn.style.display = 'none';
    }
    document.getElementById('cartModal')?.classList.add('hidden');
    const f = document.getElementById('loginForm'); if (f) { f.reset(); }
    const loginError = document.getElementById('loginError');
    if (loginError) loginError.classList.add('hidden');

    const rememberedUser = localStorage.getItem('fastRememberedUser');
    if (rememberedUser) {
        document.getElementById('adminUser').value = rememberedUser;
        document.getElementById('rememberMe').checked = true;
    }
}

function handleLoginSubmit(e) {
    e.preventDefault();
    const u = document.getElementById('adminUser').value.trim().toLowerCase();
    const p = document.getElementById('adminPass').value;
    const rememberUser = document.getElementById('rememberMe').checked;
    const loginError = document.getElementById('loginError');
    loginError.classList.add('hidden');

    const found = users.find(x => x.username.toLowerCase() === u && x.password === p);
    if (found) {
        if (rememberUser) localStorage.setItem('fastRememberedUser', u);
        else localStorage.removeItem('fastRememberedUser');

        isAdmin = true; // Global var
        sessionStorage.setItem('fastAdmin', '1');
        sessionStorage.setItem('fastRole', found.role);
        currentUserRole = found.role; // Global
        showAdminPanel();
    } else {
        loginError.textContent = ' Login ou senha incorretos!';
        loginError.classList.remove('hidden');
    }
}

function handleLogout() {
    isAdmin = false;
    sessionStorage.removeItem('fastAdmin');
    sessionStorage.removeItem('fastRole');
    showLoginModal();
}

function showAdminPanel() {
    document.getElementById('loginModal').classList.add('hidden');

    // Support both admin.html (adminWrapper) and fast.html (adminPanel)
    const adminPanel = document.getElementById('adminWrapper') || document.getElementById('adminPanel');
    if (adminPanel) adminPanel.classList.remove('hidden');

    document.getElementById('publicStore')?.classList.add('hidden');
    document.getElementById('cartBtn')?.classList.add('hidden');
    document.getElementById('cartBtnDesktop')?.classList.add('hidden');
    document.getElementById('floatingCartButton')?.classList.add('hidden');
    document.getElementById('cartModal')?.classList.add('hidden');

    const role = currentUserRole || sessionStorage.getItem('fastRole') || 'admin';
    if (role === 'caixa') {
        showToast('Sem acesso ao painel administrativo para este perfil.', 'error');
        showPublicStore();
        return;
    }

    const usersCard = document.getElementById('usersList')?.parentElement;
    if (usersCard) usersCard.style.display = (role === 'admin') ? 'block' : 'none';

    loadProductsAdmin();
    renderUsers();
    showPanel('ordersPanelFast');
    loadDashboardOrders();
}

// ========================================
// USER MANAGEMENT
// ========================================

// ========================================
// USER MANAGEMENT
// ========================================

function loadUsers() {
    const saved = localStorage.getItem('fastUsers');
    if (saved) {
        users = JSON.parse(saved);
    } else {
        // Default admin if none exists
        users = [{ username: 'fastsavorys', password: '123', role: 'admin' }];
        saveUsers();
    }
}

function saveUsers() {
    localStorage.setItem('fastUsers', JSON.stringify(users));
}

function renderUsers() {
    const ul = document.getElementById('usersList');
    if (!ul) return;
    ul.innerHTML = users.map((u, i) => `
    <li class="flex justify-between items-center py-2 border-b last:border-0">
      <span class="text-sm text-gray-700">${u.username} (${u.role || 'admin'})</span>
      <button onclick="deleteUser(${i})" class="text-red-500 hover:text-red-700 text-xs font-semibold">Excluir</button>
    </li>
  `).join('');
}

async function deleteUser(index) {
    const confirmed = await showConfirm('Excluir este usuário?', {
        title: 'Excluir Usuário',
        icon: '',
        danger: true
    });
    if (confirmed) {
        users.splice(index, 1);
        saveUsers();
        showToast('Usuário excluído!', 'success');
        renderUsers();
    }
}

function handleUserSubmit(e) {
    e.preventDefault();
    const username = document.getElementById('newUsername').value.trim(); // Fixed ID from 'userName' to 'newUsername'
    const password = document.getElementById('newPassword').value; // Fixed ID from 'userPass' to 'newPassword'
    const role = document.getElementById('newRole').value; // Fixed ID from 'userRole' to 'newRole'

    // Fix: Listen to Dropdown Change
    document.getElementById('adminCategoryFilter')?.addEventListener('change', (e) => {
        window.adminFilter = e.target.value;
        loadProductsAdmin();
    });

    document.getElementById('adminProductStatusFilter')?.addEventListener('change', (e) => {
        window.adminFilter = e.target.value;
        loadProductsAdmin();
    });

    if (!username || !password) {
        showToast('Preencha usuário e senha', 'error');
        return;
    }

    if (users.some(u => u.username.toLowerCase() === username.toLowerCase())) {
        showToast('Usuário já existe.', 'error');
        return;
    }
    users.push({ username, password, role });
    saveUsers();
    renderUsers();
    e.target.reset();
}

// ========================================
// PRODUCT MANAGEMENT (ADMIN)
// ========================================

// let adminFilter = 'all'; // handled by global
window.loadProductsAdmin = function loadProductsAdmin() {
    const c = document.getElementById('productsList');
    if (!c) {
        return;
    }
    const role = currentUserRole || sessionStorage.getItem('fastRole') || 'admin';

    const filtered = products.filter(p => {
        const isVisible = (p.visible !== false);
        if (window.adminFilter === 'hidden') return !isVisible;
        if (window.adminFilter === 'seasonal') return p.startDate && p.endDate;
        if (window.adminFilter === 'unavailable') return p.unavailableToday;
        if (window.adminFilter === 'active') return isVisible && !p.unavailableToday;
        if (window.adminFilter === 'all') return true;
        // Simplified robust filter (case insensitive)
        const match = (p.category || '').toLowerCase() === (window.adminFilter || '').toLowerCase();
        return match;
    });

    const categories = [...new Set(filtered.map(p => p.category))];
    const categoryLabels = { salgados: 'Salgados', mini: 'Mini Salgados', kits: 'Kits Festa', bolos: 'Bolos', bebidas: 'Bebidas', adicionais: 'Adicionais' };

    c.innerHTML = categories.map(cat => {
        const catProds = filtered.filter(p => p.category === cat);
        return `
      <div class="mb-4">
        <h4 class="font-bold text-gray-700 border-b pb-1 mb-2 uppercase text-xs tracking-wider">${categoryLabels[cat] || cat}</h4>
        <div class="space-y-2">
          ${catProds.map(p => {
            const isSeasonal = p.startDate && p.endDate;
            const isVisible = p.visible !== false;
            const statusColor = !isVisible ? 'bg-gray-100 border-gray-300 opacity-70' :
                p.unavailableToday ? 'bg-red-50 border-red-200' :
                    'bg-white border-gray-200';

            return `
            <div class="flex items-center justify-between p-3 rounded-lg border ${statusColor} shadow-sm transition-all hover:shadow-md">
              <div class="flex items-center gap-3 overflow-hidden">
                <div class="w-10 h-10 rounded-md bg-gray-100 flex items-center justify-center flex-shrink-0 relative overflow-hidden">
                  ${(window.isValidImageUrl ? window.isValidImageUrl(p.image) : !!p.image) ? `<img src="${p.image}" class="w-full h-full object-cover">` : `<span class="text-xl">${p.emoji}</span>`}
                  ${!isVisible ? `<div class="absolute inset-0 bg-gray-500/30 flex items-center justify-center"><i class="fas fa-eye-slash text-white text-xs"></i></div>` : ''}
                </div>
                <div class="min-w-0">
                  <p class="font-medium text-gray-800 text-sm truncate pr-2">${p.name}</p>
                  <p class="text-xs text-gray-500 font-mono">R$ ${p.price.toFixed(2).replace('.', ',')}</p>
                  ${isSeasonal ? `<span class="text-[10px] bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded">Sazonal</span>` : ''}
                  ${p.isEncomenda ? `<span class="text-[10px] bg-purple-100 text-purple-700 px-1.5 py-0.5 rounded">Encomenda</span>` : ''}
                  ${p.unavailableToday ? `<span class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-bold">Indisp. Hoje</span>` : ''}
                  ${p.catalog_enabled === false ? `<span class="text-[10px] bg-gray-200 text-gray-600 px-1.5 py-0.5 rounded">Sem Catálogo</span>` : ''}
                </div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <button onclick="editProduct(${p.id})" class="p-2 text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-full transition-colors" title="Editar">
                  <span></span>
                </button>
                <button onclick="toggleVisibility(${p.id})" class="p-2 text-gray-600 hover:text-gray-800 hover:bg-gray-50 rounded-full transition-colors" title="${isVisible ? 'Ocultar' : 'Mostrar'}">
                  <span>${isVisible ? '' : ''}</span>
                </button>
                <button onclick="confirmDelete(${p.id}, '${p.name.replace(/'/g, "\\'")}')" class="p-2 text-red-600 hover:text-red-800 hover:bg-red-50 rounded-full transition-colors" title="Excluir">
                  <span></span>
                </button>
              </div>
            </div>
            
            <!-- Confirmação de exclusão inline -->
            <div id="deleteConfirm_${p.id}" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg mt-1 text-center animate-fade-in">
              <p class="text-sm text-red-800 mb-2 font-medium">Excluir "${p.name}"?</p>
              <div class="flex justify-center gap-3">
                <button onclick="cancelDelete(${p.id})" class="px-3 py-1 bg-white border border-gray-300 rounded text-xs text-gray-600 hover:bg-gray-50">Cancelar</button>
                <button onclick="handleDelete(${p.id})" class="px-3 py-1 bg-red-600 text-white rounded text-xs hover:bg-red-700 shadow-sm">Sim, Excluir</button>
              </div>
            </div>
            `;
        }).join('')}
        </div>
      </div>
    `;
    }).join('');
}

async function handleProductSubmit(e) {
    e.preventDefault();
    const name = document.getElementById('productName').value.trim();
    const description = document.getElementById('productDescription').value.trim();
    const price = parseFloat(document.getElementById('productPrice').value || '0');
    const category = document.getElementById('productCategory').value;
    const imageFile = document.getElementById('productImage').files[0];

    let imageUrl = null;
    if (imageFile) {
        const uploadedUrl = await uploadImageToStorage(imageFile);
        if (uploadedUrl) {
            imageUrl = uploadedUrl;
        } else {
            showToast('⚠️ Não foi possível enviar a imagem. O produto será salvo sem imagem.', 'warning', 5000);
            imageUrl = null;
        }
    }

    await saveProduct(name, description, price, category, imageUrl);
}

// Global functions exposed for onclick handlers
window.editProduct = function (id) {
    window.editingProductId = id; // Global state 
    const p = products.find(x => x.id === id);
    if (!p) return;

    // Helper for safe assignment
    const setField = (elId, value) => {
        const el = document.getElementById(elId);
        if (el) el.value = value ?? '';
    };
    const setChecked = (elId, value) => {
        const el = document.getElementById(elId);
        if (el) el.checked = !!value;
    };

    // Set the hidden productId field for form submission
    setField('productId', id);

    // Update form title
    const formTitle = document.getElementById('formTitle');
    if (formTitle) formTitle.textContent = 'Editar Produto';

    setField('productName', p.name);
    setField('productDescription', p.description || '');
    setField('productPrice', p.price);
    setField('productCategory', p.category);

    setField('productStartDate', p.startDate || '');
    setField('productEndDate', p.endDate || '');
    setChecked('productUnavailableToday', p.unavailableToday);
    setChecked('productPromoActive', p.promo?.active);
    setField('productPromoType', p.promo?.type || 'percent');
    setField('productPromoValue', p.promo?.value || '');

    setChecked('productIsEncomenda', p.isEncomenda);
    setChecked('productBlockMassa', p.blockMassa);
    setChecked('productBlockRecheio', p.blockRecheio);

    // Catalog fields
    setChecked('productCatalogEnabled', p.catalog_enabled !== false);
    setChecked('catalogVegan', p.catalog_vegan);
    setField('catalogPhrase', p.catalog_phrase || '');
    setField('catalogOrder', p.catalog_order || 0);

    // Size options checkboxes
    try {
        const sizes = p.catalog_size_options ? JSON.parse(p.catalog_size_options) : [];
        setChecked('catalogSizeSmall', sizes.includes('Pequeno'));
        setChecked('catalogSizeLarge', sizes.includes('Grande'));
    } catch (e) {
        setChecked('catalogSizeSmall', false);
        setChecked('catalogSizeLarge', false);
    }

    // Flavor selection
    if (p.category === 'mini') {
        const fs = p.flavor_selection;
        setChecked('flavorSelectionEnabled', fs?.enabled);
        setField('flavorSelectionMax', fs?.maxFlavors || 3);
    }

    // Show promo fields if promo is active
    const promoFields = document.getElementById('promoFields');
    if (promoFields && p.promo?.active) {
        promoFields.classList.remove('hidden');
    }

    // Show the modal
    const modal = document.getElementById('productFormModal');
    if (modal) modal.classList.remove('hidden');
}

window.cancelEditProduct = function () {
    window.editingProductId = null;
    const form = document.getElementById('productForm');
    if (form) form.reset();
    const submitBtn = document.getElementById('productSubmitBtn');
    if (submitBtn) submitBtn.textContent = '➕ Adicionar Produto';
    const cancelBtn = document.getElementById('cancelEditBtn');
    if (cancelBtn) cancelBtn.classList.add('hidden');
}

window.confirmDelete = function (id) {
    const el = document.getElementById(`deleteConfirm_${id}`);
    if (el) el.classList.remove('hidden');
}

window.cancelDelete = function (id) {
    const el = document.getElementById(`deleteConfirm_${id}`);
    if (el) el.classList.add('hidden');
}

window.handleDelete = async function (id) {
    products = products.filter(p => p.id !== id);
    if (window.supabaseClient) {
        await window.supabaseClient.from('fast_products').delete().eq('id', id);
    }
    await saveProducts(); // Local backup + sync
    loadProductsAdmin();
    loadProductsPublic(); // Update public view too
}

// ========================================
// IMAGE UPLOAD & COMPRESSION
// ========================================

async function compressImage(file, maxWidth = 800, maxHeight = 800, quality = 0.8) {
    return new Promise((resolve, reject) => {
        if (!file.type.startsWith('image/')) { resolve(file); return; }
        const reader = new FileReader();
        reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
                let width = img.width;
                let height = img.height;
                if (width > maxWidth) { height = (height * maxWidth) / width; width = maxWidth; }
                if (height > maxHeight) { width = (width * maxHeight) / height; height = maxHeight; }
                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);
                canvas.toBlob((blob) => {
                    if (blob) {
                        const compressedFile = new File([blob], file.name, { type: 'image/jpeg', lastModified: Date.now() });
                        resolve(compressedFile);
                    } else resolve(file);
                }, 'image/jpeg', quality);
            };
            img.onerror = () => resolve(file);
            img.src = e.target.result;
        };
        reader.onerror = () => resolve(file);
        reader.readAsDataURL(file);
    });
}

async function uploadImageToStorage(file) {
    try {
        const compressedFile = await compressImage(file, 800, 800, 0.8);
        const fileExt = 'jpg';
        const fileName = `product_${Date.now()}.${fileExt}`;
        const filePath = `products/${fileName}`;
        const { data, error } = await window.supabaseClient.storage.from('fast-images')
            .upload(filePath, compressedFile, { cacheControl: '3600', upsert: false, contentType: 'image/jpeg' });
        if (error) throw error;
        const { data: urlData } = window.supabaseClient.storage.from('fast-images').getPublicUrl(filePath);
        return urlData.publicUrl;
    } catch (error) {
        console.error('Erro ao enviar imagem:', error);
        return null;
    }
}

// ========================================
// ORDER DASHBOARD (KPIs & LISTS)
// ========================================

async function loadDashboardOrdersLegacy() {
    const container = document.getElementById('ordersListContainer');
    if (!container) return;
    const dateFilter = document.getElementById('ordersFilterDate')?.value || 'today';
    const statusFilter = document.getElementById('ordersFilterStatus')?.value || 'all';

    try {
        const now = new Date();
        let startDate = null, endDate = null;
        if (dateFilter === 'today') {
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate()).toISOString();
            endDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1).toISOString();
        } else if (dateFilter === 'yesterday') {
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1).toISOString();
            endDate = new Date(now.getFullYear(), now.getMonth(), now.getDate()).toISOString();
        } else if (dateFilter === 'week') {
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 7).toISOString();
            endDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1).toISOString();
        } else if (dateFilter === 'month') {
            startDate = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();
            endDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1).toISOString();
        }

        let query = window.supabaseClient.from('fast_orders').select('*').order('created_at', { ascending: false });
        if (startDate && endDate) query = query.gte('created_at', startDate).lt('created_at', endDate);
        if (statusFilter !== 'all') query = query.eq('status', statusFilter);

        const { data: orders, error } = await query;
        if (error) throw error;

        updateOrderStats(orders || []);
        updateKPIsDashboard(orders || [], dateFilter);
        renderDashboardOrders(orders || []);

    } catch (error) {
        console.error('Erro ao carregar pedidos:', error);
        container.innerHTML = `<div class="text-center py-8 text-red-500"><p>Erro ao carregar pedidos.</p></div>`;
    }
}

function updateOrderStats(orders) {
    const counts = { pending: 0, preparing: 0, confirmed: 0, delivered: 0, cancelled: 0 };
    orders.forEach(o => { if (counts[o.status] !== undefined) counts[o.status]++; });
    document.getElementById('ordersCountNew').textContent = counts.pending;
    document.getElementById('ordersCountPreparing').textContent = counts.preparing;
    document.getElementById('ordersCountReady').textContent = counts.confirmed;
    document.getElementById('ordersCountDelivery').textContent = 0; // Legacy field?
    document.getElementById('ordersCountDelivered').textContent = counts.delivered;
    document.getElementById('ordersCountCanceled').textContent = counts.cancelled;
}

function updateKPIsDashboard(orders, dateFilter) {
    try {
        const paidOrders = orders.filter(o => o.status === 'delivered' || o.payment_status === 'paid' || o.payment_status === 'paid_full');
        const validOrders = orders.filter(o => o.status !== 'cancelled');
        const faturamento = paidOrders.reduce((sum, o) => sum + (o.total || 0), 0);

        document.getElementById('kpiFaturamento').textContent = `R$ ${faturamento.toFixed(2).replace('.', ',')}`;
        document.getElementById('kpiTotalPedidos').textContent = orders.length;

        const ticketMedio = validOrders.length > 0 ? faturamento / validOrders.length : 0;
        document.getElementById('kpiTicketMedio').textContent = `R$ ${ticketMedio.toFixed(2).replace('.', ',')}`;

        const maiorPedido = validOrders.length > 0 ? Math.max(...validOrders.map(o => o.total || 0)) : 0;
        document.getElementById('kpiMaiorPedido').textContent = `R$ ${maiorPedido.toFixed(2).replace('.', ',')}`;
    } catch (e) { console.warn('[KPIs] Erro:', e); }
}

function renderDashboardOrders(orders) {
    const container = document.getElementById('ordersListContainer');
    if (orders.length === 0) {
        container.innerHTML = `<div class="text-center py-12 text-gray-500"><p>Nenhum pedido encontrado</p></div>`;
        return;
    }

    // (Rendering logic copied from fast.html)
    // ... Simplified for brevity, need full template here ...
    // Since I can't put 6000 chars in a single string easily without mess, I will try to keep it cleaner.
    // I will rely on the fact that I'm replacing the code in fast.html.

    // NOTE: Ideally we should use a shared renderer, but for admin Dashboard it's specific.
    // I will assume the renderDashboardOrders logic from fast.html is available or I must copy it FULLY.
    // I'll copy the full function body from the previous view (lines 11993-12104).

    const STATUS_LABELS = {
        'pending': { emoji: '📋', label: 'Recebido', color: 'blue' },
        'accepted': { emoji: '✅', label: 'Aceito', color: 'purple' },
        'preparing': { emoji: '👨‍🍳', label: 'Em Preparo', color: 'yellow' },
        'confirmed': { emoji: '✅', label: 'Pronto', color: 'green' },
        'delivered': { emoji: '✅', label: 'Entregue', color: 'gray' },
        'cancelled': { emoji: '❌', label: 'Cancelado', color: 'red' }
    };

    const PAYMENT_STATUS_LABELS = {
        'pending': { emoji: '⏳', label: 'Pendente', color: 'gray' },
        'awaiting_payment': { emoji: '⏳', label: 'Aguardando Pgto', color: 'yellow' },
        'paid_partial': { emoji: '💰', label: 'Entrada Paga (50%)', color: 'orange' },
        'paid_full': { emoji: '✅', label: 'Pago Total', color: 'green' },
        'cash': { emoji: '💵', label: 'Dinheiro', color: 'green' },
        'pix': { emoji: '💳', label: 'PIX', color: 'green' }
    };

    // Full render implementation
    container.innerHTML = orders.map(order => {
        const status = STATUS_LABELS[order.status] || STATUS_LABELS.pending;
        const time = new Date(order.created_at).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        const date = new Date(order.created_at).toLocaleDateString('pt-BR');
        const items = order.items || [];
        const itemsSummary = items.slice(0, 5).map(i => {
            let itemText = `${i.quantity}x ${i.name}`;
            if (i.note) itemText += ` <span class="text-purple-600 text-xs">(${i.note})</span>`;
            return itemText;
        }).join('<br>');
        const moreItems = items.length > 5 ? `<br><span class="text-gray-500">+${items.length - 5} itens</span>` : '';
        const deliveryType = order.delivery_type === 'entrega' ? '🚚 Entrega' : '👨‍🍳 Retirada';
        const address = order.address ? `${order.address.street}, ${order.address.number}` : '';

        // Payment info
        const isCardPayment = order.payment_method === 'cartao1x' || order.payment_method === 'cartao2x' || order.payment_method === 'card_stripe';
        const paymentMethod = order.payment_method === 'cartao1x' ? '🔄 Cartão 1x' :
            order.payment_method === 'cartao2x' ? '🔄 Cartão 1x' :
                order.payment_method === 'pix' ? '🔄 PIX' :
                    order.payment_method === 'dinheiro' ? '🔄 Dinheiro' : 'â³ Pendente';
        const paymentStatus = PAYMENT_STATUS_LABELS[order.payment_status] || PAYMENT_STATUS_LABELS.pending;
        const needsAcceptance = isCardPayment && order.status === 'pending' && !order.payment_link;
        const partiallyPaid = order.payment_status === 'paid_partial';

        return `
          <div class="bg-white border rounded-lg p-4 shadow-sm ${isCardPayment ? 'border-l-4 border-l-purple-500' : ''}">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
              <div>
                <p class="text-sm text-gray-500">${date} é s ${time} - <strong class="text-rose-600">${order.order_code || formatOrderCode(order.order_sequence || order.id)}</strong></p>
                <p class="font-semibold text-gray-800">${order.client_name || 'Cliente'}</p>
                <p class="text-sm text-gray-600">🔄 ${order.client_phone || '-'}</p>
              </div>
              <div class="text-right">
                <span class="inline-block px-2 py-1 rounded text-sm bg-${status.color}-100 text-${status.color}-800">
                  ${status.emoji} ${status.label}
                </span>
                <p class="text-lg font-bold text-rose-600 mt-1">R$ ${(order.total || 0).toFixed(2).replace('.', ',')}</p>
              </div>
            </div>
            
            <div class="text-sm text-gray-700 mb-3">
              <p><strong>Itens:</strong> ${itemsSummary}${moreItems}</p>
              <p><strong>Tipo:</strong> ${deliveryType}</p>
              ${address ? `<p><strong>Endereço:</strong> ${address}</p>` : ''}
              ${order.scheduled_date ? `<p class="text-orange-600 font-medium"><strong>🔄& Encomenda:</strong> ${order.scheduled_date}</p>` : ''}
              <p><strong>Pagamento:</strong> ${paymentMethod} 
                ${isCardPayment ? `<span class="inline-block px-2 py-0.5 rounded text-xs bg-${paymentStatus.color}-100 text-${paymentStatus.color}-800 ml-1">${paymentStatus.emoji} ${paymentStatus.label}</span>` : ''}
              </p>
              ${partiallyPaid ? `<p class="text-orange-600 font-medium">⚠️ Falta pagar restante na entrega/retirada</p>` : ''}
              ${order.payment_link ? `<p class="text-xs text-purple-600 truncate"><strong>Link:</strong> <a href="${order.payment_link}" target="_blank" class="underline">${order.payment_link}</a></p>` : ''}
            </div>
            
            <div class="flex flex-wrap gap-2">
              ${needsAcceptance ? `
                <button onclick="acceptCardOrder(${order.id})" class="flex-1 bg-purple-600 hover:bg-purple-700 text-white px-3 py-2 rounded text-sm font-medium">🔄 Aceitar & Enviar Link</button>
              ` : ''}
              
              <button onclick="prepareOrderUpdate('${order.id}')" class="flex-1 bg-blue-100 hover:bg-blue-200 text-blue-700 px-3 py-2 rounded text-sm">🔄 Atualizar Status</button>
              
              <button onclick="openWhatsAppForOrder('${order.client_phone}')" class="bg-green-100 hover:bg-green-200 text-green-700 px-3 py-2 rounded text-sm">🔄 WhatsApp</button>
              
              ${isCardPayment && order.payment_link ? `
                <button onclick="resendPaymentLink(${order.id}, '${order.client_phone}', '${order.client_name || 'Cliente'}', '${order.order_code || ''}', '${order.payment_link}')" class="bg-purple-100 hover:bg-purple-200 text-purple-700 px-3 py-2 rounded text-sm">🔄 Reenviar Link</button>
              ` : ''}
            </div>
          </div>
          `;
    }).join('');
}

