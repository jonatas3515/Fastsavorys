async function handleSaveSpecialDiscountConfig() {
    const msg = document.getElementById('specialDiscountMsg');
    const minOrders = parseInt(document.getElementById('specialDiscountMinOrders')?.value);
    const minVal = parseFloat(document.getElementById('specialDiscountMinVal')?.value);
    const type = document.getElementById('specialDiscountType')?.value || 'percentage';
    const val = parseFloat(document.getElementById('specialDiscountValue')?.value);
    const active = document.getElementById('specialDiscountActive')?.checked ?? true;

    if (isNaN(minOrders) || isNaN(val)) {
        if (msg) {
            msg.textContent = 'Preencha os campos corretamente.';
            msg.className = 'text-red-600 text-sm ml-2';
        } else {
            showToast('Preencha os campos corretamente.', 'error');
        }
        return;
    }

    if (msg) {
        msg.textContent = 'Salvando...';
        msg.className = 'text-gray-500 text-sm ml-2';
    }

    if (!window.SpecialDiscountService) {
        showToast('Serviço indisponível.', 'error');
        return;
    }

    const config = {
        min_orders: minOrders,
        min_order_value: isNaN(minVal) ? 0 : minVal,
        discount_type: type,
        discount_value: val,
        active: !!active
    };

    const ok = await window.SpecialDiscountService.saveConfig(config);
    if (ok) {
        showToast('Configuração salva!', 'success');
        if (msg) {
            msg.textContent = 'Configuração salva!';
            msg.className = 'text-green-600 text-sm ml-2';
        }
        if (typeof window.loadSpecialDiscountConfig === 'function') await window.loadSpecialDiscountConfig();
    } else {
        showToast('Erro ao salvar.', 'error');
        if (msg) {
            msg.textContent = 'Erro ao salvar.';
            msg.className = 'text-red-600 text-sm ml-2';
        }
    }
}

async function handleSaveBirthdayDiscountConfig() {
    const msg = document.getElementById('birthdayDiscountMsg');
    const type = document.getElementById('birthdayDiscountType')?.value || 'percentage';
    const val = parseFloat(document.getElementById('birthdayDiscountValue')?.value);
    const active = document.getElementById('birthdayDiscountActive')?.checked ?? true;

    if (isNaN(val) || val <= 0) {
        if (msg) {
            msg.textContent = 'Preencha o valor do desconto.';
